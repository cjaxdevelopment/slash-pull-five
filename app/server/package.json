{
  "name": "@spf/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:bootstrap": "tsx src/cli.ts bootstrap",
    "db:create-account": "tsx src/cli.ts create-account",
    "db:seed-accounts": "tsx src/cli.ts seed-accounts",
    "db:export": "tsx src/cli.ts export-database",
    "db:restore": "tsx src/cli.ts restore-database",
    "db:reset-password": "tsx src/cli.ts reset-password"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@spf/shared": "*",
    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0"
  }
}
