# Copy to .env in the repository root. Local mode persists an embedded PostgreSQL database.
NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
DATABASE_MODE=local
# Use DATABASE_MODE=postgres for Docker or hosted PostgreSQL. Required in production.
DATABASE_URL=postgres://spf:change-me@localhost:5432/slash_pull_five
# Production automatically requires verified TLS. For Heroku buildpacks use its bundled CA store:
# DATABASE_SSL_CA_FILE=/usr/lib/ssl/certs/ca-certificates.crt
# For another provider, use its CA bundle path or the normal trusted certificate store.
TRUST_PROXY=false
# One-time owner creation. Set these, run npm run db:bootstrap, then remove the password.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_GUILD_NAME=
BOOTSTRAP_REGION=us
BOOTSTRAP_RULESET=normal
BOOTSTRAP_FACTION=alliance
# Optional additional private account: set these, run npm run db:create-account, then remove the password.
ACCOUNT_USERNAME=
ACCOUNT_PASSWORD=

# Professions directory: server-side Blizzard developer client credentials only.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Comma-separated existing account usernames. Planner ownership does not grant directory admin.
PROFS_ADMIN_USERNAMES=eizzo
PROFS_GAME_VERSION=forever
PROFS_REGION=us
PROFS_PROFILE_NAMESPACE=profile-forever-us
PROFS_DATA_NAMESPACE=static-forever-us
# Forever guilds are realmless. Rewound is pinned to Normal (ruleset 2).
PROFS_GUILD_SLUG=rewound
# Automatically seed every roster character and refresh it hourly while the server runs.
PROFS_AUTO_REFRESH=true
PROFS_REFRESH_INTERVAL_MINUTES=60
